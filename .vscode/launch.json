{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "frontend + backend",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start all",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
