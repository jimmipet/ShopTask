model Product {
  id               Int        @id @default(autoincrement())
  title            String
  price            Decimal
  category         String
  description      String
  image            String?
  creationDate     DateTime   @default(now()) @map("creation_date") @db.Timestamptz
  modificationDate DateTime   @default(now()) @map("modification_date") @db.Timestamptz
  cartItems        CartItem[]

  @@map("products")
}
